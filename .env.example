# Copie para .env.local e preencha. Nunca commite .env.local.

# --- Supabase (valores locais aparecem em `npm run db:start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# App Secret do app da Meta, usado para validar X-Hub-Signature-256
WA_APP_SECRET=
# Texto qualquer, igual ao configurado no painel da Meta para o webhook
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- Parser de ofertas (IA) ---
# Modelo usado pelo AI SDK, no formato provedor/modelo (definido no M3)
AI_MODEL=
# Chave do provedor de IA escolhido
AI_GATEWAY_API_KEY=

# --- Afiliados ---
AMAZON_ASSOCIATE_TAG=

# --- Jobs agendados (Supabase Cron -> /api/jobs/*) ---
# Gere com: openssl rand -hex 32
CRON_SECRET=

# --- Domínio público usado nos links /r/<code> ---
PUBLIC_DOMAIN=localhost:3000
